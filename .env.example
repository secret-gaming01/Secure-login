# ============================================================
# Secure-login â€” Configuration backend (copier vers .env)
# ============================================================

# --- Serveur ---
PORT=8080
# URL publique (utilisÃ©e dans les emails de vÃ©rification/reset)
BASE_URL=http://localhost:8080

# --- Base de donnÃ©es (PostgreSQL OU SQLite) ---
DATABASE_URL=postgres://secure:secure@localhost:5432/secure_login
# Exemple SQLite :
# DATABASE_URL=sqlite://./data.db

# --- Secrets CRITIQUES (gÃ©nÃ©rer avec : openssl rand -hex 32) ---
# ClÃ© de signature JWT (>= 64 caractÃ¨res recommandÃ©, HS512)
JWT_SECRET=CHANGE_ME_super_secret_jwt_key_at_least_64_characters_long_xxxxxxxxxxxxxxxx
# ClÃ© de chiffrement AES-256-GCM (hex 64 chars) ou passphrase quelconque (dÃ©rivÃ©e en SHA-256)
ENCRYPTION_KEY=CHANGE_ME_encryption_master_key
# Pepper ajoutÃ©e aux mots de passe AVANT Argon2id (jamais stockÃ©e en base)
PASSWORD_PEPPER=CHANGE_ME_global_password_pepper

# --- Tokens & sessions ---
ACCESS_TOKEN_TTL_SECS=900            # 15 min
REFRESH_TOKEN_TTL_SECS=2592000       # 30 jours

# --- WebAuthn / Passkeys ---
RP_ID=localhost                      # domaine sans protocole ni port
RP_NAME=Secure Login
RP_ORIGIN=http://localhost:8080      # origine exacte navigateur

# --- RÃ©seau & anti-abus ---
TRUST_PROXY=false                    # true derriÃ¨re nginx/traefik (lit X-Forwarded-For)
CORS_ORIGINS=*                       # liste sÃ©parÃ©e par des virgules en prod
RATE_LIMIT_PER_MIN=240               # requÃªtes max / minute / IP
MAX_FAILED_LOGINS=5                  # tentatives avant verrouillage
LOCKOUT_BASE_SECS=900                # cooldown initial (double Ã  chaque Ã©chec, cap 24h)
SUSPICIOUS_FAIL_THRESHOLD=10         # Ã©checs/24h pour marquer une IP suspecte
DOUBLE_ACCOUNT_MIN=2                 # comptes sur mÃªme IP = signal double compte

# --- GÃ©olocalisation IP (ip-api.com gratuit, ~45 req/min) ---
GEO_ENABLED=true

# --- Captcha optionnel (activÃ© automatiquement aprÃ¨s N Ã©checs si configurÃ©) ---
# Valeurs : turnstile | hcaptcha | recaptcha
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
CAPTCHA_SITE_KEY=

# --- MFA ---
MFA_ISSUER=SecureLogin

# --- Emails (mode console par dÃ©faut : les liens sont affichÃ©s dans les logs serveur) ---
EMAIL_MODE=console                   # console | smtp (smtp non implÃ©mentÃ©, voir limites)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com

# --- Logs ---
RUST_LOG=info

# --- Bootstrap owner : cree automatiquement ce compte owner au PREMIER
#     demarrage si la base est vide. Mot de passe aleatoire affiche dans les
#     logs (a changer immediatement). Laisser vide pour desactiver.
OWNER_EMAIL=
