# ============================================================
# Secure-login — Configuration backend (copier vers .env)
# ============================================================

# --- Serveur ---
PORT=8080
# URL publique (utilisée dans les emails de vérification/reset)
BASE_URL=http://localhost:8080

# --- Base de données (PostgreSQL OU SQLite) ---
DATABASE_URL=postgres://secure:secure@localhost:5432/secure_login
# Exemple SQLite :
# DATABASE_URL=sqlite://./data.db

# --- Secrets CRITIQUES (générer avec : openssl rand -hex 32) ---
# Clé de signature JWT (>= 64 caractères recommandé, HS512)
JWT_SECRET=CHANGE_ME_super_secret_jwt_key_at_least_64_characters_long_xxxxxxxxxxxxxxxx
# Clé de chiffrement AES-256-GCM (hex 64 chars) ou passphrase quelconque (dérivée en SHA-256)
ENCRYPTION_KEY=CHANGE_ME_encryption_master_key
# Pepper ajoutée aux mots de passe AVANT Argon2id (jamais stockée en base)
PASSWORD_PEPPER=CHANGE_ME_global_password_pepper

# --- Tokens & sessions ---
ACCESS_TOKEN_TTL_SECS=900            # 15 min
REFRESH_TOKEN_TTL_SECS=2592000       # 30 jours

# --- WebAuthn / Passkeys ---
RP_ID=localhost                      # domaine sans protocole ni port
RP_NAME=Secure Login
RP_ORIGIN=http://localhost:8080      # origine exacte navigateur

# --- Réseau & anti-abus ---
TRUST_PROXY=false                    # true derrière nginx/traefik (lit X-Forwarded-For)
CORS_ORIGINS=*                       # liste séparée par des virgules en prod
RATE_LIMIT_PER_MIN=240               # requêtes max / minute / IP
MAX_FAILED_LOGINS=5                  # tentatives avant verrouillage
LOCKOUT_BASE_SECS=900                # cooldown initial (double à chaque échec, cap 24h)
SUSPICIOUS_FAIL_THRESHOLD=10         # échecs/24h pour marquer une IP suspecte
DOUBLE_ACCOUNT_MIN=2                 # comptes sur même IP = signal double compte

# --- Géolocalisation IP (ip-api.com gratuit, ~45 req/min) ---
GEO_ENABLED=true

# --- Captcha optionnel (activé automatiquement après N échecs si configuré) ---
# Valeurs : turnstile | hcaptcha | recaptcha
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
CAPTCHA_SITE_KEY=

# --- MFA ---
MFA_ISSUER=SecureLogin

# --- Emails (mode console par défaut : les liens sont affichés dans les logs serveur) ---
EMAIL_MODE=console                   # console | smtp (smtp non implémenté, voir limites)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com

# --- Logs ---
RUST_LOG=info
